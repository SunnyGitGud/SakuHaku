# AniList API client, create one at https://anilist.co/settings/developer
# with redirect URL http://localhost:8888/callback. Only needed to log in.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# ANILIST_REDIRECT_URI=http://localhost:8888/callback

# Optional settings, see README.md
# SAKUHAKU_PROXY=socks5://127.0.0.1:1080
# SAKUHAKU_NYAA_URL=https://nyaa.si
# SAKUHAKU_DOWNLOAD_DIR=
# SAKUHAKU_PLAYER=mpv
# SAKUHAKU_NO_TRACKING=1
